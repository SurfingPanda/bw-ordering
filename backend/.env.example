APP_NAME="bw Superbakeshop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must be the real production domain in production — canonical tags, Open
# Graph URLs, sitemap.xml, and JSON-LD structured data all derive from this.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ordering
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Supabase is used ONLY for authentication (password + Google/Facebook OAuth,
# plus the profiles table enforcing contact-number uniqueness). Everything
# else (products, orders, CMS, uploads) lives in MySQL above.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap admin/editor role allowlists — env wins over the user_roles table,
# so the founding admin here can never be locked out. Comma-separated emails.
ADMIN_EMAILS=
EDITOR_EMAILS=

# Gates the online-payment checkout option (PayMongo hosted Checkout
# Sessions). Without this set, that checkout option is silently unavailable.
PAYMONGO_SECRET_KEY=

# Legacy holdover from a separate Vite-dev-server SPA that no longer exists —
# harmless to leave unset; see config/cors.php.
FRONTEND_URL=http://localhost:5173
